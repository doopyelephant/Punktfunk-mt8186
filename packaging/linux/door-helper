#!/bin/bash
# punktfunk door helper (root): turns "Reachable without logging in" on or off for one user.
#
#   door-helper on  <user>   the box's host runs as the punktfunk system user from boot
#   door-helper off <user>   the user's own host serves the box again
#   door-helper ports        the recorded owner's ports, copied before each door start
#
# Started by punktfunk-door-on@<user>.service and punktfunk-door-off@<user>.service, which
# 49-punktfunk-door.rules lets members of `punktfunk-update` start. The instance name is data, not
# a command: the user must be an ordinary account in that group. `ports` is
# punktfunk-door.service's ExecStartPre.
#
# Both directions are idempotent, and a run that stopped halfway converges on the next. A first
# `on` that fails before the box's ports move puts the box back, and an `off` that can't hand the
# files home starts the door again, so neither leaves the box without a host or a console. The one
# record of "on, and for whom" is $STATE/owner, which only root writes: `on` refuses while it names
# someone else, and `off` runs only for the user it names. The box's files move once: `on` copies
# the user's into /var/lib/punktfunk and marks that in $STATE/door-on, so a repeat never overwrites
# what the door has changed since; `off` copies the door's back to the user and clears both.
#
# Every read and write that touches a user's home runs as that user, so a link the user plants
# there can't make root read or overwrite anything the user couldn't.
set -eu
export LC_ALL=C

BOX=/var/lib/punktfunk
# The seat supervisor's own directory, root's alone. `owner` there is the one account the door is
# on for, and the one the supervisor adopts as the box owner's row, so the door can't pick another.
STATE=/var/lib/punktfunk-seats
RECORD="$STATE/owner"
MARK="$STATE/door-on"
SEATS=/usr/libexec/punktfunk/punktfunk-seats
GROUP=punktfunk-update
# What the box's host keeps: identity, id, pairings, profiles, display and hook settings, and the
# console's password hash. `profiles/` holds the avatars.
FILES="native-cert.pem native-key.pem uniqueid punktfunk1-paired.json profiles.json display-settings.json hooks.json web-password"

die() {
    echo "door-helper: $*" >&2
    exit 1
}

verb=${1:-}
user=${2:-}
case $verb in
on | off) ;;
# The owner the last `on` recorded; with none, the door has no ports to take.
ports) user=$(cat "$RECORD" 2>/dev/null) || exit 0 ;;
*) die "usage: door-helper on|off <user>, or door-helper ports" ;;
esac
[ "$(id -u)" = 0 ] || die "run as root"
# The name rule of the seat supervisor, which adopting the owner enforces (pf-seats): lowercase
# letters, digits, `_` and `-`, starting with a letter or `_`, at most 20 characters.
case $user in
'' | *[!a-z0-9_-]* | [!a-z_]*) die "'$user' is not a user name the seats accept" ;;
esac
[ "${#user}" -le 20 ] || die "'$user' is longer than the seats accept"

passwd_row=$(getent passwd "$user") || die "no user '$user'"
uid=$(printf '%s' "$passwd_row" | cut -d: -f3)
home=$(printf '%s' "$passwd_row" | cut -d: -f6)
{ [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]; } || die "'$user' is not an ordinary account"
# The recorded owner may switch the door off after leaving the group.
if [ "$verb" != off ]; then
    id -nG "$user" | tr ' ' '\n' | grep -qx "$GROUP" || die "'$user' is not in the $GROUP group"
fi
OWN="$home/.config/punktfunk"

# `ports` runs inside the door's start, which `on` waits for while it holds this lock.
if [ "$verb" != ports ]; then
    exec 9>/run/punktfunk-door.lock
    flock 9
fi
recorded=$(cat "$RECORD" 2>/dev/null || true)
case $verb in
on) [ -z "$recorded" ] || [ "$recorded" = "$user" ] || die "the door is on for $recorded: turn it off from that account first" ;;
off) [ "$recorded" = "$user" ] || die "the door is not on for $user" ;;
esac

as_user() { runuser -u "$user" -- "$@"; }
as_door() { runuser -u punktfunk -- "$@"; }

# The user's systemd manager, when they have one. A user with no login and no linger has none, and
# then there is nothing running to change.
user_ctl() { runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/$uid" systemctl --user "$@" 2>/dev/null; }

# $1 a file name under $BOX, written there from stdin as the door. The door owns $BOX, so root
# never writes a path in it: a link the door plants there leads only where the door can go.
to_door() {
    # shellcheck disable=SC2016 # the inner shell expands $1, not this one
    as_door sh -c 'umask 077; cat >"$1.tmp" && mv -f "$1.tmp" "$1"' sh "$BOX/$1"
}

# $1 a file name under $OWN, copied to $BOX for the door.
take() {
    as_user test -f "$OWN/$1" || return 0
    as_user cat -- "$OWN/$1" | to_door "$1"
}

# $1 a file name under $BOX, copied back to the user. Read as the door, written as the user, so
# neither side's links lead anywhere that user couldn't go.
give() {
    as_door test -f "$BOX/$1" || return 0
    # shellcheck disable=SC2016 # the inner shell expands $1, not this one
    as_door cat -- "$BOX/$1" | as_user sh -c 'umask 077; mkdir -p "$(dirname "$1")"; cat >"$1.tmp" && mv -f "$1.tmp" "$1"' sh "$OWN/$1"
}

# SteamOS keeps the console's password in web.env, beside its session secret and bind. There the
# door takes the password line alone, and hands it back into that file.
PASSWORD_LINE='^[[:space:]]*PUNKTFUNK_UI_PASSWORD(_HASH)?='
steamos_password() { as_user test -f "$OWN/web.env" && ! as_user test -f "$OWN/web-password"; }

take_password() {
    steamos_password || return 0
    as_user cat -- "$OWN/web.env" | { grep -E "$PASSWORD_LINE" || true; } | to_door web-password
}

give_password() {
    if ! steamos_password; then
        give web-password
        return 0
    fi
    line=$(as_door cat -- "$BOX/web-password" 2>/dev/null | grep -E "$PASSWORD_LINE" | tail -n1)
    [ -n "$line" ] || return 0
    # shellcheck disable=SC2016 # the inner shell expands its own arguments
    as_user sh -c 'umask 077; { grep -vE "$3" "$1" || true; } >"$1.tmp" && printf "%s\n" "$2" >>"$1.tmp" && mv -f "$1.tmp" "$1"' \
        sh "$OWN/web.env" "$line" "$PASSWORD_LINE"
}

# The box's ports as the owner's host.env moves them, which the door binds in its place. Taken at
# each door start: host.env stays the owner's file, and the door never writes a port.
PORT_LINE='^[[:space:]]*PUNKTFUNK_(MGMT_BIND|NATIVE_PORT)[[:space:]]*='

take_ports() {
    as_user cat -- "$OWN/host.env" 2>/dev/null | { grep -E "$PORT_LINE" || true; } | to_door host.env
}

safe_name() {
    case $1 in '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;; esac
}

take_avatars() {
    as_door mkdir -p -m 0700 "$BOX/profiles"
    for name in $(as_user ls -1 -- "$OWN/profiles" 2>/dev/null); do
        safe_name "$name" && take "profiles/$name"
    done
}

give_avatars() {
    for name in $(as_door ls -1 -- "$BOX/profiles" 2>/dev/null); do
        safe_name "$name" && give "profiles/$name"
    done
}

# An older helper kept the mark in $BOX, where the door could write it. The mark of a recorded
# owner moves to $STATE; any other is dropped.
legacy_mark() {
    getent passwd punktfunk >/dev/null || return 0
    if [ -n "$recorded" ] && as_door test -f "$BOX/door-on"; then
        : >"$MARK"
    fi
    as_door rm -f "$BOX/door-on"
}

wait_for_socket() {
    for _ in $(seq 1 30); do
        [ -S /run/punktfunk/seats.sock ] && return 0
        sleep 0.5
    done
    die "the seat supervisor did not start"
}

# A first `on` that fails puts the box back as it was: no record, mark or owner row, and the
# supervisor off unless it was on already. The user's own files were only copied.
undo_on() {
    echo "door-helper: couldn't switch the door on, putting the box back" >&2
    if systemctl is-active --quiet punktfunk-seats.service; then
        row=$(owner_row || true)
        [ -z "$row" ] || "$SEATS" delete "$row" >/dev/null || true
    fi
    rm -f "$MARK" "$RECORD" "/run/punktfunk/seats/$user.env"
    [ "$seats_were_up" = 1 ] || systemctl disable --now punktfunk-seats.service || true
}

door_on() {
    fresh=0
    [ -n "$recorded" ] || fresh=1
    seats_were_up=0
    if systemctl is-active --quiet punktfunk-seats.service; then seats_were_up=1; fi
    getent group punktfunk >/dev/null || groupadd --system punktfunk
    if ! getent passwd punktfunk >/dev/null; then
        shell=$(command -v nologin || echo /usr/sbin/nologin)
        useradd --system --no-user-group --gid punktfunk --home-dir "$BOX" --shell "$shell" punktfunk
    fi
    install -d -m 0711 -o punktfunk -g punktfunk "$BOX"
    # The shared games folder's group; the owner's Steam moves games into it at their next login.
    getent group punktfunk-games >/dev/null || groupadd --system punktfunk-games
    usermod -aG punktfunk-games "$user"
    install -d -m 0711 -o root -g root "$STATE"
    legacy_mark
    [ "$fresh" = 0 ] || trap undo_on EXIT
    printf '%s\n' "$user" >"$RECORD.tmp"
    chmod 0600 "$RECORD.tmp"
    mv -f "$RECORD.tmp" "$RECORD"
    if [ ! -e "$MARK" ]; then
        for f in $FILES; do take "$f"; done
        take_password
        take_avatars
        : >"$MARK"
    fi
    systemctl enable --now punktfunk-seats.service
    wait_for_socket
    "$SEATS" adopt-owner "$user" >/dev/null
    systemctl enable punktfunk-door.service punktfunk-web-door.service
    trap - EXIT
    # The box's ports are the door's from here, so the user's console and host leave them first.
    # The host restarts on the owner row's contract: its own ports, and the box's identity.
    user_ctl stop punktfunk-web.service || true
    user_ctl try-restart punktfunk-host.service || true
    systemctl restart punktfunk-door.service punktfunk-web-door.service
    echo "door on for $user"
}

# `list` prints id, state, account, ports, `owner=true|false`, then the name.
owner_row() {
    "$SEATS" list | awk '$6 == "owner=true" { print $1; exit }'
}

# The door stopped to hand its files home and they didn't arrive: it comes back as it was.
restore_door() {
    echo "door-helper: couldn't hand the door's files back, starting the door again" >&2
    systemctl start --no-block punktfunk-door.service punktfunk-web-door.service || true
}

door_off() {
    systemctl stop punktfunk-web-door.service punktfunk-door.service || true
    legacy_mark
    if [ -e "$MARK" ]; then
        trap restore_door EXIT
        for f in $FILES; do [ "$f" = web-password ] || give "$f"; done
        give_password
        give_avatars
        trap - EXIT
        # The files are home. A repeat must not copy the door's stale ones over the user's.
        rm -f "$MARK"
    fi
    # From here only forward: each step is tried, and the record stays until all of them held.
    problems=0
    if systemctl is-active --quiet punktfunk-seats.service; then
        # Seats the door placed stop with it; their accounts and profiles stay for the next time.
        "$SEATS" list | awk '$2 == "Running" || $2 == "Starting" { print $1 }' | while read -r id; do
            "$SEATS" stop "$id" >/dev/null || true
        done
        row=$(owner_row || true)
        [ -z "$row" ] || "$SEATS" delete "$row" >/dev/null || problems=1
    fi
    # A stopped supervisor leaves the owner's contract behind, and their host and console read it.
    rm -f "/run/punktfunk/seats/$user.env"
    systemctl disable --now punktfunk-web-door.service punktfunk-door.service punktfunk-seats.service || problems=1
    user_ctl try-restart punktfunk-host.service || true
    # Their console comes back only if it was theirs to begin with.
    if user_ctl is-enabled --quiet punktfunk-web.service; then
        user_ctl start punktfunk-web.service || true
    fi
    [ "$problems" = 0 ] || die "cleanup after switching off $user failed, switch it off again"
    rm -f "$RECORD"
    echo "door off for $user"
}

case $verb in
on) door_on ;;
off) door_off ;;
ports) take_ports ;;
esac
